{
	"name": "jumpway-web-ui",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@12.4.2",
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || >=26.0.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"build:dist": "vite build --outDir dist",
		"preview:dist": "vite preview --outDir dist",
		"check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && prettier --check .",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:real": "playwright test --project real",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@iconify-json/lucide": "^1.2.133",
		"@iconify-json/simple-icons": "^1.2.96",
		"@playwright/test": "^1.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^24.13.5",
		"jsdom": "^30.1.0",
		"prettier": "^3.9.7",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	}
}
